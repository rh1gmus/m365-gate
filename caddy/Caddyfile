# m365-gate edge. Everything comes from environment variables set by compose.yaml.
{
	# The gate listens on one port only. Don't try to bind :80 for HTTP->HTTPS redirects.
	auto_https disable_redirects
	email {$ACME_EMAIL}
}

{$GATE_HOST}:{$GATE_PORT} {
	tls {
		dns cloudflare {env.CF_DNS_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	encode gzip

	# Optional: paths answered with 404 before sign-in or the app is reached. Space-separated list in GATE_BLOCK_PATHS
	# (unset by default; the placeholder default never matches a real request).
	@blocked path {$GATE_BLOCK_PATHS:/.m365-gate-none}
	respond @blocked 404

	# Sign out: clear the oauth2-proxy session, then end the Microsoft session
	# (otherwise SSO signs the user straight back in), then return to the app,
	# which sends the user to the Microsoft sign-in page.
	redir /logout "/oauth2/sign_out?rd=https%3A%2F%2Flogin.microsoftonline.com%2Fcommon%2Foauth2%2Fv2.0%2Flogout%3Fpost_logout_redirect_uri%3Dhttps%253A%252F%252F{$GATE_HOST}%253A{$GATE_PORT}%252F" 302

	reverse_proxy gate-proxy:4180
}

# Anything addressed to another Host name (right port, wrong name) gets 421 instead of
# Caddy's default empty 200. Only the site above has a certificate.
:{$GATE_PORT} {
	header -Server
	respond 421
}
