# m365-gate settings. Put these in the CONSUMING project's .env (git-ignored), then: chmod 600 .env
# No quotes, no spaces around "=", and keep comments on their own lines.
# (Compose reads "KEY=   # note" as the value "# note".)

# ---- Where the gate listens and what it protects
# DNS name pointing at this host (Cloudflare: "DNS only", grey cloud)
GATE_HOST=app.example.com
# HTTPS port to publish. Each gated app on one host needs its own port.
GATE_PORT=443
# The app's service name and port on the gate_backend network
GATE_UPSTREAM=http://app:8080
# Optional: host interface to bind (default 0.0.0.0), sign-in lifetime in hours (default 12), Caddy image override
#GATE_BIND=0.0.0.0
#GATE_SESSION_HOURS=12
#GATE_CADDY_IMAGE=ghcr.io/rh1gmus/m365-gate-caddy:2.10.2-cloudflare0.2.4

# ---- TLS: Cloudflare API token ("Edit zone DNS" template, scoped to the zone) for Let's Encrypt DNS-01
CF_DNS_API_TOKEN=
# Optional: Let's Encrypt expiry-notice email
ACME_EMAIL=

# ---- Microsoft Entra ID app registration (one per project; see docs/entra-app-registration.md)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ---- Who may sign in (set at least one)
# Comma-separated UPNs, or * for anyone in the tenant
ALLOWED_EMAILS=
# Optional: comma-separated Entra group object IDs. The user must be in at least one.
ALLOWED_GROUPS=

# ---- Session cookie encryption key: 32 random bytes, base64url. Generate with:
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
OAUTH2_PROXY_COOKIE_SECRET=
